# Copy to ~/.config/polydata/polydata.env, replace every example value, and
# restrict the resulting file to the service user. Never commit the real file.

# Use a Python 3.11+ interpreter with this repository installed.
POLYDATA_PYTHON_BIN=/__MARKET_DATA_ROOT__/.venv/bin/python

POLYDATA_POSTGRES_HOST=127.0.0.1
POLYDATA_POSTGRES_PORT=45432
POLYDATA_POSTGRES_USER=poly_user
POLYDATA_POSTGRES_PASSWORD=replace-with-postgres-password
POLYDATA_POSTGRES_DATABASE=poly_data_core

# Comma-separated Polygon endpoints. The first healthy endpoint is preferred.
POLYDATA_POLYGON_RPC_URLS=http://127.0.0.1:28545
POLYDATA_POLYGON_FALLBACK_RPC_URLS=https://replace-with-reviewed-polygon-fallback.example

POLYDATA_ORDERFILLED_CLICKHOUSE_CONTAINER=polydata_clickhouse_orderfilled
POLYDATA_ORDERFILLED_CLICKHOUSE_DATABASE=poly_orderfilled
POLYDATA_ORDERFILLED_CLICKHOUSE_USER=poly_user
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password

POLYDATA_GAMMA_API_BASE=https://gamma-api.polymarket.com
# If direct Polymarket HTTP access is unavailable, standard HTTP_PROXY,
# HTTPS_PROXY and NO_PROXY entries may be added to the private environment file.
POLYDATA_MARKET_SYNC_INTERVAL_SECONDS=900
POLYDATA_MARKET_REVISIT_MAX_PAGES=100
POLYDATA_ORDERFILLED_WINDOW_BLOCKS=200
POLYDATA_ORDERFILLED_RETRY_TOKENS=200
POLYDATA_ORACLE_INTERVAL_SECONDS=600
