[Unit]
Description=Polymarket V2 module history with verified window receipts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/__MARKET_DATA_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
Environment=PYTHONPATH=/__MARKET_DATA_ROOT__/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/__MARKET_DATA_ROOT__/.venv/bin/python -m market_data.oracle_modules --apply --window-blocks 1000000 --rpc-url https://polygon.gateway.tenderly.co
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=60
Nice=10
